<?xml version="1.0" encoding="utf-8"?>
<!-- In-game tests for the SWI Bounty Hunter playthrough. Runs only in the "swibh_test" gamestart
     (libraries/gamestarts.xml), one test at a time, then quits the game.

     Every line the runner reads starts with "[swibh-test]":
       RUN START <n> tests
       INFO <name>: <data>        numbers a test measured, copied into the report
       VERDICT <name>: <answer>   the answer to the test plan's question, copied into the report
       PASS <name>: <detail>
       FAIL <name>: <detail>
       DONE passed=<n> failed=<n>

     Adding a test: a root cue named after it that fires on event_cue_signalled, sets things up,
     and signals Report exactly once (from a result cue or a timeout cue) with
     table[$name, $ok, $detail]. Then add it to $Tests in Run. Clean up what it spawned, so tests
     don't affect each other. -->
<mdscript name="SWIBH_Tests" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Run">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart"/>
        <check_value value="player.module == 'swibh_test'"/>
      </conditions>
      <!-- No delay here: X4 activates sub-cues as soon as these conditions are met, before a
           delay would end, so Begin could run before these variables exist -->
      <actions>
        <!-- Set to false to keep the game open after the run, e.g. to look around after a failure -->
        <set_value name="$QuitWhenDone" exact="true"/>
        <set_value name="$Tests" exact="[Smoke, T01PayCap, T01Knw904, CombatSignals, Engagement]"/>
        <set_value name="$Index" exact="0"/>
        <set_value name="$StartAge" exact="player.age"/>
        <set_value name="$Passed" exact="0"/>
        <set_value name="$Failed" exact="0"/>
      </actions>
      <cues>
        <!-- Waits for Emergent Missions' own start cues (kEMissions sets $IsSWIExists, UserSettings
             sets the debug chances its library reads), or 30s, so the tests see EM as a real game
             would. The Smoke test reports what was found. -->
        <cue name="Begin" checkinterval="1s">
          <conditions>
            <check_value value="(@md.kuertee_emergent_missions.kEMissions.$IsSWIExists != null and @md.kuertee_emergent_missions.UserSettings.$debugChance != null) or player.age gt $StartAge + 30s"/>
          </conditions>
          <!-- Let the game settle after loading -->
          <delay exact="2s"/>
          <actions>
            <debug_text text="'[swibh-test] RUN START %s tests'.[$Tests.count]" filter="general"/>
            <signal_cue cue="NextTest"/>
          </actions>
        </cue>

        <cue name="NextTest" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Index" operation="add"/>
            <do_if value="$Index le $Tests.count">
              <signal_cue cue="$Tests.{$Index}"/>
            </do_if>
            <do_else>
              <debug_text text="'[swibh-test] DONE passed=%s failed=%s'.[$Passed, $Failed]" filter="general"/>
              <do_if value="$QuitWhenDone">
                <signal_cue cue="Quit"/>
              </do_if>
            </do_else>
          </actions>
        </cue>

        <!-- Each test signals this once, with table[$name, $ok, $detail] -->
        <cue name="Report" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <do_if value="event.param.$ok">
              <set_value name="$Passed" operation="add"/>
              <debug_text text="'[swibh-test] PASS %s: %s'.[event.param.$name, event.param.$detail]" filter="general"/>
            </do_if>
            <do_else>
              <set_value name="$Failed" operation="add"/>
              <debug_text text="'[swibh-test] FAIL %s: %s'.[event.param.$name, event.param.$detail]" filter="general"/>
            </do_else>
            <signal_cue cue="NextTest"/>
          </actions>
        </cue>

        <cue name="Quit">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <!-- Give the log a moment to flush -->
          <delay exact="2s"/>
          <actions>
            <quit_to_desktop/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- ===== Tests ===== -->

    <!-- Smoke: the run is on the test gamestart, SWI is loaded (its galactic Empire faction and its
         TIE fighter ware exist; EM uses the same ware check, kuertee_emergent_missions.xml 228), and
         Emergent Missions' script ran its start cue in SWI mode (kEMissions, 215-230). -->
    <cue name="Smoke">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Problems" exact="''"/>
        <set_value name="$Galaxy" exact="@player.galaxy.macro.id"/>
        <set_value name="$Empire" exact="@faction.galempire"/>
        <set_value name="$Tie" exact="@ware.tie_fighter"/>
        <set_value name="$EmState" exact="@md.kuertee_emergent_missions.kEMissions.state"/>
        <set_value name="$EmSwi" exact="@md.kuertee_emergent_missions.kEMissions.$IsSWIExists"/>
        <do_if value="player.module != 'swibh_test'">
          <set_value name="$Problems" exact="$Problems + ' gamestart is %s, not swibh_test;'.[player.module]"/>
        </do_if>
        <do_if value="not $Empire">
          <set_value name="$Problems" exact="$Problems + ' faction.galempire not found (SWI not loaded?);'"/>
        </do_if>
        <do_if value="not $Tie">
          <set_value name="$Problems" exact="$Problems + ' ware.tie_fighter not found (SWI not loaded?);'"/>
        </do_if>
        <do_if value="$EmState != cuestate.complete">
          <set_value name="$Problems" exact="$Problems + ' Emergent Missions kEMissions cue state is %s, expected complete;'.[$EmState]"/>
        </do_if>
        <do_if value="not $EmSwi">
          <set_value name="$Problems" exact="$Problems + ' Emergent Missions is not in SWI mode ($IsSWIExists %s);'.[$EmSwi]"/>
        </do_if>
        <debug_text text="'[swibh-test] INFO smoke: gamestart %s, galaxy %s, sector %s, faction.galempire %s, ware.tie_fighter %s, EM kEMissions %s, EM $IsSWIExists %s'.[player.module, $Galaxy, @player.sector.macro.id, @$Empire.knownname, @$Tie.name, $EmState, $EmSwi]" filter="general"/>
        <signal_cue_instantly cue="Report" param="table[$name = 'smoke', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'gamestart %s on %s; SWI loaded (%s); Emergent Missions running in SWI mode'.[player.module, $Galaxy, $Empire.knownname] else $Problems)]"/>
      </actions>
    </cue>

    <!-- T01 L/XL pay cap (test-plan.md T01; research/swi-bounty.md 4.4 and 15). Spawns an L and an
         XL ship of SWI factions and runs EM's own CapRewardBasedOnMissionTarget library on each,
         with a 1,000,000 Cr reward, exactly as Mission_Hunt_Resolve does (EM 5684-5694): the target,
         reward_forTargetKills as RewardForTarget, the player's damage reward as
         RewardForPlayerKills, then RewardCr = ((part1)f + (part2)f) * 1ct. As a cross-check it also
         runs a copy of the cap expression (EM 7340-7375) and logs both, so a library that can't be
         called still gives numbers (the log says which is which).

         Targets: hapan_nova_macro (SWI, class ship_l, Hapes "Nova-class Battle Cruiser", the
         offers seen on 2026-10-31) owned by hapes, and isd_2_macro (SWI, class ship_xl, Imperial
         Star Destroyer II, group galempire_isd_xl) owned by galempire. No loadout, crew or pilot:
         they only need a size and a class, and must not fight. 30 km apart from the player. -->
    <cue name="T01PayCap">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <create_ship name="$L" macro="hapan_nova_macro" sector="player.sector">
          <owner exact="faction.hapes" overridenpc="true"/>
          <loadout>
            <level exact="0"/>
          </loadout>
          <safepos object="player.occupiedship" z="30km" allowyaxis="true"/>
        </create_ship>
        <create_ship name="$XL" macro="isd_2_macro" sector="player.sector">
          <owner exact="faction.galempire" overridenpc="true"/>
          <loadout>
            <level exact="0"/>
          </loadout>
          <safepos object="player.occupiedship" z="-30km" allowyaxis="true"/>
        </create_ship>
        <!-- The reward a finished hunt would have: half for the target's kill record, half for the
             player's damage, 1,000,000 Cr in all (an L class reward is about 1.0 M, swi-bounty 4.4) -->
        <set_value name="$RewardForTargetKills" exact="500000Cr"/>
        <set_value name="$RewardForPlayerKills" exact="500000Cr"/>
      </actions>
      <cues>
        <!-- Measure a moment later, once the ships are in the sector -->
        <cue name="T01PayCap_Measure">
          <delay exact="2s"/>
          <actions>
            <set_value name="$Total" exact="$RewardForTargetKills + $RewardForPlayerKills"/>
            <set_value name="$Problems" exact="''"/>
            <set_value name="$Results" exact="[]"/>
            <do_for_each name="$Ship" in="[$L, $XL]">
              <do_if value="not @$Ship.exists">
                <set_value name="$Problems" exact="$Problems + ' a target ship was not created;'"/>
                <continue/>
              </do_if>
              <set_value name="$Label" exact="if $Ship.isclass.ship_xl then 'XL' else (if $Ship.isclass.ship_l then 'L' else 'not L/XL')"/>
              <debug_text text="'[swibh-test] INFO t01_pay_cap: %s target %s (%s), owner %s, class %s, isclass.ship_l %s, isclass.ship_xl %s, size %s (raw %s)'.[$Label, $Ship.macro.id, $Ship.knownname, $Ship.owner.id, $Ship.class, $Ship.isclass.ship_l, $Ship.isclass.ship_xl, $Ship.size, ($Ship.size)f]" filter="general"/>
              <do_if value="$Ship.size le 0">
                <set_value name="$Problems" exact="$Problems + ' %s target size is %s, so the cap is meaningless;'.[$Label, $Ship.size]"/>
              </do_if>

              <!-- 1. EM's own library, called as Mission_Hunt_Resolve calls it (EM 5684-5689) -->
              <set_value name="$Capped" exact="null"/>
              <run_actions ref="md.kuertee_emergent_missions.CapRewardBasedOnMissionTarget" result="$Capped">
                <param name="Cue_Mission" value="this"/>
                <param name="MissionTarget" value="$Ship"/>
                <param name="RewardForTarget" value="$RewardForTargetKills"/>
                <param name="RewardForPlayerKills" value="$RewardForPlayerKills"/>
              </run_actions>
              <set_value name="$EmPay" exact="null"/>
              <do_if value="$Capped != null">
                <!-- EM 5694: the sum it pays with reward_player -->
                <set_value name="$EmPay" exact="(($Capped.$RewardForTarget)f + ($Capped.$RewardForPlayerKills)f) * 1ct"/>
                <debug_text text="'[swibh-test] INFO t01_pay_cap: %s EM library: in %s + %s = %s; out %s + %s; RewardCr (EM 5694) %s (raw %s)'.[$Label, $RewardForTargetKills, $RewardForPlayerKills, $Total, $Capped.$RewardForTarget, $Capped.$RewardForPlayerKills, $EmPay, ($EmPay)f]" filter="general"/>
              </do_if>
              <do_else>
                <debug_text text="'[swibh-test] INFO t01_pay_cap: %s EM library md.kuertee_emergent_missions.CapRewardBasedOnMissionTarget returned nothing; see the copy below'.[$Label]" filter="general"/>
              </do_else>

              <!-- 2. A copy of the library's expression (EM 7347-7365), as a cross-check -->
              <set_value name="$Mult" exact="0"/>
              <do_if value="$Ship.isclass.ship_l">
                <set_value name="$Mult" exact="5"/>
              </do_if>
              <do_elseif value="$Ship.isclass.ship_xl">
                <set_value name="$Mult" exact="2"/>
              </do_elseif>
              <set_value name="$CopyForTarget" exact="$RewardForTargetKills"/>
              <set_value name="$CopyForPlayerKills" exact="$RewardForPlayerKills"/>
              <set_value name="$CapReward" exact="null"/>
              <do_if value="$Mult">
                <set_value name="$CapReward" exact="$Ship.size * $Mult"/>
                <do_if value="$Total ge $CapReward">
                  <set_value name="$CopyForTarget" exact="(($RewardForTargetKills)f / ($Total)f * $CapReward)ct"/>
                  <set_value name="$CopyForPlayerKills" exact="(($RewardForPlayerKills)f / ($Total)f * $CapReward)ct"/>
                </do_if>
              </do_if>
              <set_value name="$CopyPay" exact="(($CopyForTarget)f + ($CopyForPlayerKills)f) * 1ct"/>
              <debug_text text="'[swibh-test] INFO t01_pay_cap: %s copy of EM 7340-7375: mult %s, CapReward = size * mult = %s (raw %s), total ge cap %s; RewardCr %s (raw %s)'.[$Label, $Mult, $CapReward, (if $CapReward == null then null else ($CapReward)f), (if $CapReward == null then null else $Total ge $CapReward), $CopyPay, ($CopyPay)f]" filter="general"/>

              <set_value name="$Pay" exact="if $EmPay != null then $EmPay else $CopyPay"/>
              <append_to_list name="$Results" exact="table[$label = $Label, $size = $Ship.size, $pay = $Pay, $source = (if $EmPay != null then 'EM library' else 'copy of EM 7340-7375'), $bites = ($Pay lt $Total)]"/>
            </do_for_each>

            <set_value name="$Summary" exact="''"/>
            <set_value name="$Bites" exact="0"/>
            <do_for_each name="$Result" in="$Results">
              <set_value name="$Summary" exact="$Summary + ' %s (size %s) pays %s (%s);'.[$Result.$label, $Result.$size, $Result.$pay, $Result.$source]"/>
              <do_if value="$Result.$bites">
                <set_value name="$Bites" operation="add"/>
              </do_if>
            </do_for_each>
            <do_if value="$Results.count">
              <debug_text text="'[swibh-test] VERDICT t01_pay_cap: %s: a %s reward%s'.[(if $Bites == $Results.count then 'cap bites' else (if $Bites == 0 then 'cap doesn\'t bite' else 'cap bites for %s of %s targets'.[$Bites, $Results.count])), $Total, $Summary]" filter="general"/>
            </do_if>
            <do_if value="$Results.count lt 2">
              <set_value name="$Problems" exact="$Problems + ' measured %s of 2 targets;'.[$Results.count]"/>
            </do_if>
            <signal_cue_instantly cue="Report" param="table[$name = 't01_pay_cap', $ok = ($Problems == ''), $detail = (if $Problems == '' then '%s reward:%s'.[$Total, $Summary] else $Problems)]"/>
            <do_if value="@$L.exists">
              <destroy_object object="$L"/>
            </do_if>
            <do_if value="@$XL.exists">
              <destroy_object object="$XL"/>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- T01 for the KNW-904 hunt (research/save-check-knw-904.md): the real mission's target and
         reward. Spawns mc40a_macro (SWI, class ship_l, "MC40A Light Cruiser") owned by newrepublic,
         as KNW-904 is, and runs EM's CapRewardBasedOnMissionTarget with the mission's own numbers:
         reward_forTargetKills 35,835 Cr, and two player shares of the 1,141,130 Cr target reward:
         100% damage and a player kill (x 1.25, EM 7157-7166), and 10% damage, another ship's kill.
         Logs class, size and the capped RewardCr (EM 5694) for each. -->
    <cue name="T01Knw904">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <create_ship name="$Target" macro="mc40a_macro" sector="player.sector">
          <owner exact="faction.newrepublic" overridenpc="true"/>
          <loadout>
            <level exact="0"/>
          </loadout>
          <safepos object="player.occupiedship" x="30km" allowyaxis="true"/>
        </create_ship>
        <set_value name="$RewardForTargetKills" exact="35835Cr"/>
        <!-- 1,141,130 Cr x 1.25 = 1,426,412.50 Cr, and 1,141,130 Cr x 10% = 114,113 Cr -->
        <set_value name="$Cases" exact="[table[$label = '100% damage, player kill', $kills = 142641250ct], table[$label = '10% damage, not player kill', $kills = 11411300ct]]"/>
      </actions>
      <cues>
        <cue name="T01Knw904_Measure">
          <delay exact="2s"/>
          <actions>
            <set_value name="$Problems" exact="''"/>
            <set_value name="$Summary" exact="''"/>
            <do_if value="not @$Target.exists">
              <set_value name="$Problems" exact="' mc40a_macro was not created;'"/>
            </do_if>
            <do_else>
              <debug_text text="'[swibh-test] INFO t01_knw904: target %s (%s), owner %s, class %s, isclass.ship_l %s, isclass.ship_xl %s, size %s (raw %s)'.[$Target.macro.id, $Target.knownname, $Target.owner.id, $Target.class, $Target.isclass.ship_l, $Target.isclass.ship_xl, $Target.size, ($Target.size)f]" filter="general"/>
              <do_if value="$Target.size le 0">
                <set_value name="$Problems" exact="$Problems + ' size is %s;'.[$Target.size]"/>
              </do_if>
              <do_for_each name="$Case" in="$Cases">
                <set_value name="$Total" exact="$RewardForTargetKills + $Case.$kills"/>
                <set_value name="$Capped" exact="null"/>
                <run_actions ref="md.kuertee_emergent_missions.CapRewardBasedOnMissionTarget" result="$Capped">
                  <param name="Cue_Mission" value="this"/>
                  <param name="MissionTarget" value="$Target"/>
                  <param name="RewardForTarget" value="$RewardForTargetKills"/>
                  <param name="RewardForPlayerKills" value="$Case.$kills"/>
                </run_actions>
                <do_if value="$Capped == null">
                  <set_value name="$Problems" exact="$Problems + ' EM library returned nothing for %s;'.[$Case.$label]"/>
                  <continue/>
                </do_if>
                <set_value name="$Pay" exact="(($Capped.$RewardForTarget)f + ($Capped.$RewardForPlayerKills)f) * 1ct"/>
                <debug_text text="'[swibh-test] INFO t01_knw904: %s: in %s + %s = %s; cap size * 5 = %s; out %s + %s; RewardCr (EM 5694) %s (raw %s)'.[$Case.$label, $RewardForTargetKills, $Case.$kills, $Total, $Target.size * 5, $Capped.$RewardForTarget, $Capped.$RewardForPlayerKills, $Pay, ($Pay)f]" filter="general"/>
                <set_value name="$Summary" exact="$Summary + ' %s: %s pays %s;'.[$Case.$label, $Total, $Pay]"/>
              </do_for_each>
              <debug_text text="'[swibh-test] VERDICT t01_knw904: KNW-904 (mc40a_macro, size %s) caps to:%s'.[$Target.size, $Summary]" filter="general"/>
            </do_else>
            <signal_cue_instantly cue="Report" param="table[$name = 't01_knw904', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'mc40a_macro size %s:%s'.[$Target.size, $Summary] else $Problems)]"/>
            <do_if value="@$Target.exists">
              <destroy_object object="$Target"/>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- CombatSignals (#23 diagnostic, research/combat-hooks.md): which MD signal fires per hit?
         The 2026-11-02 run saw event_object_attacked(_object) only about once per attacker pair.
         Same scenario as Engagement (the player's ship, an X-wing wingman, a TIE Advanced (tie_advanced_macro, shielded and about an even match for the X-wing), both kept on Attack
         orders by KeepFighting, min hulls so nobody dies) for 40 s. Counts every combat event on the three
         ships per event and ship, logs the first 60 events in full, and samples each ship's shield,
         hull, lastattacktime and lastattacker every second. Passes when all three ships existed;
         the answer is in the INFO and VERDICT lines. -->
    <cue name="CombatSignals">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$OldRelation" exact="faction.galempire.relationto.{faction.player}"/>
        <set_faction_relation faction="faction.galempire" otherfaction="faction.player" value="-1"/>
        <set_value name="$Counts" exact="table[]"/>
        <set_value name="$Detailed" exact="0"/>
        <set_value name="$Begun" exact="player.age"/>
        <create_group groupname="$Ships"/>
        <create_ship name="$Wingman" macro="t65b_xwing_macro" sector="player.sector">
          <owner exact="faction.player" overridenpc="true"/>
          <pilot>
            <select race="player.entity.race" tags="tag.aipilot"/>
          </pilot>
          <loadout>
            <level exact="1.0"/>
          </loadout>
          <safepos object="player.occupiedship" x="300m" allowyaxis="true"/>
        </create_ship>
        <create_ship name="$Enemy" macro="tie_advanced_macro" sector="player.sector">
          <owner exact="faction.galempire" overridenpc="true"/>
          <pilot>
            <select faction="faction.galempire" tags="tag.aipilot"/>
          </pilot>
          <loadout>
            <level exact="1.0"/>
          </loadout>
          <safepos object="player.occupiedship" z="2km" allowyaxis="true"/>
        </create_ship>
      </actions>
      <cues>
        <cue name="CombatSignals_Start">
          <delay exact="1s"/>
          <actions>
            <do_if value="not @$Wingman.exists or not @$Enemy.exists">
              <signal_cue_instantly cue="CombatSignals_Done" param="'the wingman or the TIE Advanced was not created'"/>
            </do_if>
            <do_else>
              <set_object_min_hull object="player.occupiedship" exact="50"/>
              <set_object_min_hull object="$Wingman" exact="50"/>
              <set_object_min_hull object="$Enemy" exact="30"/>
              <set_object_commander object="$Wingman" commander="player.occupiedship" assignment="assignment.defence"/>
              <add_to_group groupname="$Ships" object="player.occupiedship"/>
              <add_to_group groupname="$Ships" object="$Wingman"/>
              <add_to_group groupname="$Ships" object="$Enemy"/>
              <run_actions ref="KeepFighting">
                <param name="Wingman" value="$Wingman"/>
                <param name="Enemy" value="$Enemy"/>
              </run_actions>
            </do_else>
          </actions>
          <cues>
            <!-- The 2026-11-02 run's TIE made one pass and stopped: keep both on their Attack orders -->
            <cue name="CombatSignals_Keep" instantiate="true" checkinterval="2s">
              <conditions>
                <check_value value="player.age lt CombatSignals.$Begun + 40s"/>
              </conditions>
              <actions>
                <run_actions ref="KeepFighting">
                  <param name="Wingman" value="CombatSignals.$Wingman"/>
                  <param name="Enemy" value="CombatSignals.$Enemy"/>
                </run_actions>
              </actions>
            </cue>

            <!-- Every combat event on the three ships, counted by event and ship macro. Table keys
                 must look like $names, hence the '$' -->
            <cue name="CombatSignals_Event" instantiate="true" namespace="this">
              <conditions>
                <check_any>
                  <event_object_attacked group="CombatSignals.$Ships"/>
                  <event_object_attacked_object group="CombatSignals.$Ships"/>
                  <event_object_shield_damaged group="CombatSignals.$Ships"/>
                  <event_object_hull_damaged group="CombatSignals.$Ships"/>
                  <event_player_attacked_object/>
                  <event_player_ship_hit/>
                </check_any>
              </conditions>
              <actions>
                <set_value name="$Key" exact="'$' + event.name + '__' + (if @event.object.macro then event.object.macro.id else 'none')"/>
                <do_if value="CombatSignals.$Counts.{$Key}?">
                  <set_value name="CombatSignals.$Counts.{$Key}" operation="add"/>
                </do_if>
                <do_else>
                  <set_value name="CombatSignals.$Counts.{$Key}" exact="1"/>
                </do_else>
                <do_if value="CombatSignals.$Detailed lt 60">
                  <set_value name="CombatSignals.$Detailed" operation="add"/>
                  <debug_text text="'[swibh-test] INFO combat_signals: t %s %s object %s param %s (%s) param2 %s param3 %s'.[player.age, event.name, @event.object.macro.id, event.param, @event.param.macro.id, event.param2, event.param3]" filter="general"/>
                </do_if>
              </actions>
            </cue>

            <cue name="CombatSignals_Sample" instantiate="true" checkinterval="1s" namespace="this">
              <conditions>
                <check_value value="player.age lt CombatSignals.$Begun + 40s"/>
              </conditions>
              <actions>
                <do_for_each name="$Ship" in="[player.occupiedship, CombatSignals.$Wingman, CombatSignals.$Enemy]">
                  <debug_text text="'[swibh-test] INFO combat_signals: sample t %s %s shield %s pct, hull %s pct, lastattacktime %s lastattacker %s, order %s'.[player.age, @$Ship.macro.id, @$Ship.shieldpercentage, @$Ship.hullpercentage, @$Ship.lastattacktime, @$Ship.lastattacker.macro.id, @$Ship.order.id]" filter="general"/>
                </do_for_each>
              </actions>
            </cue>

            <cue name="CombatSignals_End">
              <delay exact="40s"/>
              <actions>
                <do_if value="CombatSignals_Done.state != cuestate.complete">
                  <signal_cue_instantly cue="CombatSignals_Done" param="''"/>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>

        <cue name="CombatSignals_Done">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Summary" exact="''"/>
            <do_for_each name="$Key" valuename="$Count" in="$Counts">
              <set_value name="$Summary" exact="$Summary + ' %s=%s;'.[$Key, $Count]"/>
            </do_for_each>
            <debug_text text="'[swibh-test] VERDICT combat_signals: in 40 s:%s'.[$Summary]" filter="general"/>
            <set_faction_relation faction="faction.galempire" otherfaction="faction.player" value="$OldRelation"/>
            <set_object_min_hull object="player.occupiedship" exact="0"/>
            <do_if value="@$Wingman.exists">
              <destroy_object object="$Wingman"/>
            </do_if>
            <do_if value="@$Enemy.exists">
              <destroy_object object="$Enemy"/>
            </do_if>
            <signal_cue_instantly cue="Report" param="table[$name = 'combat_signals', $ok = (event.param == ''), $detail = (if event.param == '' then 'events counted:%s'.[$Summary] else event.param)]"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- Engagement (#23): the swibh extension's engagement log events (extension/swibh/md/
         swibh_engagement.xml, installed into this extension by the runner). Gives the player a
         wingman (t65b_xwing_macro, assigned on defence) and makes galempire hostile, then fights twice:
           1. a TIE Advanced (tie_advanced_macro, shielded and about an even match for the X-wing) registered as a hunt's target (HuntStarted), so the
              engagement must carry the hunt key swibh-test-hunt;
           2. another TIE Advanced that's in no hunt, so it must not.
         Each TIE Advanced attacks the player's ship and the wingman attacks it, both kept on those
         orders (KeepFighting); the TIE Advanced is kept alive (min hull) until the player's ship has taken a
         hit and the wingman has dealt one, then destroyed. Hits come from the per-projectile damage
         events. The quiet gap is 30 s, so the AI's
         passes stay one engagement, which ends with reason quiet. The player's ship and the wingman keep a
         min hull, so nobody dies. Hit counts and durations go to INFO (the hit-rate unknown).
         The runner's log check (tools/log/game-check.ts) then reads the same engagements from
         debuglog.txt with the log parser. -->
    <cue name="Engagement">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Engagements" exact="md.SWIBH_Engagement.Engagements"/>
        <set_value name="$Enemy" exact="null"/>
        <set_value name="$Problems" exact="''"/>
        <set_value name="$Summary" exact="''"/>
        <set_value name="$OldRelation" exact="faction.galempire.relationto.{faction.player}"/>
        <set_faction_relation faction="faction.galempire" otherfaction="faction.player" value="-1"/>
        <set_value name="$OldQuietGap" exact="md.SWIBH_Engagement.Engagements.$QuietGap"/>
        <set_value name="md.SWIBH_Engagement.Engagements.$QuietGap" exact="30s"/>
        <set_object_min_hull object="player.occupiedship" exact="50"/>
        <create_ship name="$Wingman" macro="t65b_xwing_macro" sector="player.sector">
          <owner exact="faction.player" overridenpc="true"/>
          <pilot>
            <select race="player.entity.race" tags="tag.aipilot"/>
          </pilot>
          <loadout>
            <level exact="1.0"/>
          </loadout>
          <safepos object="player.occupiedship" x="300m" allowyaxis="true"/>
        </create_ship>
      </actions>
      <cues>
        <cue name="Engagement_Setup">
          <delay exact="2s"/>
          <actions>
            <do_if value="not @$Wingman.exists">
              <set_value name="$Problems" exact="' t65b_xwing_macro wingman was not created;'"/>
              <signal_cue_instantly cue="Engagement_Done"/>
            </do_if>
            <do_else>
              <set_object_min_hull object="$Wingman" exact="50"/>
              <set_object_commander object="$Wingman" commander="player.occupiedship" assignment="assignment.defence"/>
              <signal_cue_instantly cue="Engagement_Fight" param="table[$phase = 1, $hunt = 'swibh-test-hunt']"/>
            </do_else>
          </actions>
        </cue>

        <!-- While a fight's TIE Advanced lives, keep it and the wingman on their Attack orders. The
             AI fights in passes with long silences, hence the test's 30 s quiet gap -->
        <cue name="Engagement_Keep" instantiate="true" checkinterval="2s">
          <conditions>
            <check_value value="@Engagement.$Enemy.isoperational"/>
          </conditions>
          <actions>
            <run_actions ref="KeepFighting">
              <param name="Wingman" value="Engagement.$Wingman"/>
              <param name="Enemy" value="Engagement.$Enemy"/>
            </run_actions>
          </actions>
        </cue>

        <!-- One fight: param table[$phase, $hunt], $hunt null for a TIE Advanced in no hunt -->
        <cue name="Engagement_Fight" instantiate="true" namespace="this">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Phase" exact="event.param.$phase"/>
            <set_value name="$Hunt" exact="event.param.$hunt"/>
            <set_value name="$Begun" exact="player.age"/>
            <create_ship name="$Enemy" macro="tie_advanced_macro" sector="player.sector">
              <owner exact="faction.galempire" overridenpc="true"/>
              <pilot>
                <select faction="faction.galempire" tags="tag.aipilot"/>
              </pilot>
              <loadout>
                <level exact="1.0"/>
              </loadout>
              <safepos object="player.occupiedship" z="2km" allowyaxis="true"/>
            </create_ship>
            <do_if value="@$Enemy.exists">
              <set_object_min_hull object="$Enemy" exact="30"/>
              <do_if value="$Hunt">
                <run_actions ref="md.SWIBH_Engagement.HuntStarted">
                  <param name="hunt" value="$Hunt"/>
                  <param name="target" value="$Enemy"/>
                </run_actions>
              </do_if>
              <set_value name="Engagement.$Enemy" exact="$Enemy"/>
              <run_actions ref="KeepFighting">
                <param name="Wingman" value="Engagement.$Wingman"/>
                <param name="Enemy" value="$Enemy"/>
              </run_actions>
            </do_if>
          </actions>
          <cues>
            <!-- Both ships have a hit in this fight's engagement (or 60 s passed): the TIE Advanced has done
                 its job. $Ships keeps the last engagement's stats after it closes, hence $Start -->
            <cue name="Engagement_Hits" checkinterval="1s">
              <conditions>
                <check_value value="not @$Enemy.exists or player.age gt $Begun + 60s or (Engagement.$Engagements.$Open and Engagement.$Engagements.$Start ge $Begun and @Engagement.$Engagements.$Ships.{player.occupiedship}.$hitsTaken gt 0 and @Engagement.$Engagements.$Ships.{Engagement.$Wingman}.$hitsDealt gt 0)"/>
              </conditions>
              <actions>
                <set_value name="$HitsAt" exact="player.age"/>
                <do_if value="@$Enemy.exists">
                  <destroy_object object="$Enemy"/>
                </do_if>
              </actions>
              <cues>
                <!-- The quiet gap ran out (30 s, then up to 2 s for the poll), or 45 s passed -->
                <cue name="Engagement_Closed" checkinterval="1s">
                  <conditions>
                    <check_value value="not Engagement.$Engagements.$Open or player.age gt $HitsAt + 45s"/>
                  </conditions>
                  <actions>
                    <set_value name="$Problems" exact="''"/>
                    <set_value name="$Closed" exact="Engagement.$Engagements.$LastClosed"/>
                    <!-- $Start is the last engagement's: one from before this fight means none opened -->
                    <do_if value="Engagement.$Engagements.$Open or not $Closed or Engagement.$Engagements.$Start lt $Begun">
                      <set_value name="$Problems" exact="' fight %s: no engagement opened and closed (hits at t %s, last start t %s, open %s);'.[$Phase, $HitsAt, Engagement.$Engagements.$Start, Engagement.$Engagements.$Open]"/>
                    </do_if>
                    <do_else>
                      <set_value name="$PlayerStats" exact="null"/>
                      <set_value name="$WingStats" exact="null"/>
                      <do_for_each name="$Stats" in="$Closed.$ships">
                        <do_if value="$Stats.$player">
                          <set_value name="$PlayerStats" exact="$Stats"/>
                        </do_if>
                        <do_elseif value="$Stats.$idcode == @Engagement.$Wingman.idcode">
                          <set_value name="$WingStats" exact="$Stats"/>
                        </do_elseif>
                        <debug_text text="'[swibh-test] INFO engagement: fight %s: %s %s (player %s) took %s hits (%s damage), dealt %s (%s), kills %s, sectors %s, between t %s and %s (%s s)'.[$Phase, $Stats.$macro, $Stats.$idcode, $Stats.$player, $Stats.$hitsTaken, $Stats.$damageTaken, $Stats.$hitsDealt, $Stats.$damageDealt, $Stats.$kills, $Stats.$sectors, Engagement.$Engagements.$Start, Engagement.$Engagements.$LastHit, Engagement.$Engagements.$LastHit - Engagement.$Engagements.$Start]" filter="general"/>
                      </do_for_each>
                      <do_if value="$Closed.$reason != 'quiet'">
                        <set_value name="$Problems" exact="$Problems + ' fight %s ended with reason %s, not quiet;'.[$Phase, $Closed.$reason]"/>
                      </do_if>
                      <do_if value="$Closed.$hunt != $Hunt">
                        <set_value name="$Problems" exact="$Problems + ' fight %s has hunt key %s, expected %s;'.[$Phase, $Closed.$hunt, $Hunt]"/>
                      </do_if>
                      <do_if value="not $PlayerStats or $PlayerStats.$hitsTaken le 0">
                        <set_value name="$Problems" exact="$Problems + ' fight %s: no hit taken by the player\'s ship;'.[$Phase]"/>
                      </do_if>
                      <do_if value="not $WingStats or $WingStats.$hitsDealt le 0">
                        <set_value name="$Problems" exact="$Problems + ' fight %s: no hit dealt by the wingman;'.[$Phase]"/>
                      </do_if>
                    </do_else>
                    <do_if value="$Hunt">
                      <run_actions ref="md.SWIBH_Engagement.HuntEnded">
                        <param name="hunt" value="$Hunt"/>
                      </run_actions>
                    </do_if>
                    <set_value name="Engagement.$Problems" exact="Engagement.$Problems + $Problems"/>
                    <set_value name="Engagement.$Summary" exact="Engagement.$Summary + ' fight %s (%s): %s;'.[$Phase, (if $Hunt then 'hunt' else 'no hunt'), (if $Problems == '' then 'ok' else 'failed')]"/>
                    <do_if value="$Phase == 1">
                      <signal_cue_instantly cue="Engagement_Fight.static" param="table[$phase = 2, $hunt = null]"/>
                    </do_if>
                    <do_else>
                      <signal_cue_instantly cue="Engagement_Done"/>
                    </do_else>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="Engagement_Done">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="md.SWIBH_Engagement.Engagements.$QuietGap" exact="$OldQuietGap"/>
            <set_faction_relation faction="faction.galempire" otherfaction="faction.player" value="$OldRelation"/>
            <set_object_min_hull object="player.occupiedship" exact="0"/>
            <do_if value="@$Wingman.exists">
              <destroy_object object="$Wingman"/>
            </do_if>
            <signal_cue_instantly cue="Report" param="table[$name = 'engagement', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'player ship and wingman logged in both engagements; hunt key only on the hunt target\'s;%s'.[$Summary] else $Problems)]"/>
          </actions>
        </cue>
      </cues>
    </cue>
    <!-- For CombatSignals and Engagement: puts the enemy back on its Attack order against the
         player's ship, and the wingman on one against it, whenever either order has ended. The
         2026-11-02 runs' TIE made one pass and stopped, and the wingman on defence never fired -->
    <library name="KeepFighting" purpose="run_actions">
      <params>
        <param name="Wingman"/>
        <param name="Enemy"/>
      </params>
      <actions>
        <do_if value="@$Enemy.isoperational and @$Enemy.order.id != 'Attack'">
          <create_order object="$Enemy" id="'Attack'" immediate="true">
            <param name="primarytarget" value="player.occupiedship"/>
          </create_order>
        </do_if>
        <do_if value="@$Enemy.isoperational and @$Wingman.isoperational and @$Wingman.order.id != 'Attack'">
          <create_order object="$Wingman" id="'Attack'" immediate="true">
            <param name="primarytarget" value="$Enemy"/>
          </create_order>
        </do_if>
      </actions>
    </library>
  </cues>
</mdscript>
