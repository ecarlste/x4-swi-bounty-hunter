        </ship>
        <inventory>
          <ware ware="inv_timewarp" amount="1"/>
        </inventory>
      </player>
      <universe ventures="false" visitors="false">
        <jobs enabled="false"/>
        <god enabled="false"/>
      </universe>
    </gamestart>
    <gamestart id="swibh_trial_m_top" name="SWIBH trial M: top (Firespray + 4 corvettes + 4 HWK-290 + 4 R-41)" description="Dev only. Bobby in a Firespray with 2 Weequay, a C-ROC Corsair, a Gozanti cruiser, 4 HWK-290 and 4 R-41 wingmen. Comm a wingman to spawn an M target." image="gamestart_bhg" group="9" tags="nosave">
      <location galaxy="sws_galaxy_macro" sector="sws_clustercoruscant_sector001_macro">
