        <god enabled="false"/>
      </universe>
    </gamestart>
    <gamestart id="swibh_trial_m_established" name="SWIBH trial M: established (HWK-290 + 3 HWK-290 + 4 R-41)" description="Dev only. Bobby in an HWK-290 with 3 HWK-290 and 4 R-41 wingmen. Comm a wingman to spawn an M target." image="gamestart_bhg" group="9" tags="nosave">
      <location galaxy="sws_galaxy_macro" sector="sws_clustercoruscant_sector001_macro">
        <position x="-1000" y="0" z="-8000"/>
      </location>
      <player macro="character_player_pirate_gamestart1_macro" money="1000000" name="Bobby">
        <ship macro="hwk_290_01_macro">
