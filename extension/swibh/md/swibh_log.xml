    <!-- Writes a hunt.kill log event. Params: hunt, victim, role, byPlayer -->
    <library name="Log_HuntKill" purpose="run_actions">
      <params>
        <param name="hunt"/>
        <param name="victim"/>
        <param name="role"/>
        <param name="byPlayer"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;hunt.kill&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$hunt]"/>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;byPlayer&quot;:' + (if $byPlayer then 'true' else 'false')"/>
        <set_value name="$Line" exact="$Line + ',&quot;role&quot;:' + '&quot;%s&quot;'.[$role]"/>
        <run_actions ref="md.SWIBH_Log.Json_Ship" result="$V1">
          <param name="In" value="$victim"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;victim&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
    <!-- Writes a hunt.end log event. Params: hunt, result, failedStep, payout, targetKills, engagements, relations, repairs -->
    <library name="Log_HuntEnd" purpose="run_actions">
      <params>
        <param name="hunt"/>
        <param name="result"/>
        <param name="failedStep" default="null"/>
        <param name="payout" default="null"/>
        <param name="targetKills" default="null"/>
        <param name="engagements" default="null"/>
        <param name="relations"/>
        <param name="repairs"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;hunt.end&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$hunt]"/>
        <do_if value="$engagements == null">
          <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;engagements&quot;:null'"/>
        </do_if>
        <do_else>
          <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;engagements&quot;:['"/>
          <do_for_each name="$E1" in="$engagements" counter="$I1">
            <do_if value="$I1 gt 1">
              <set_value name="$Line" exact="$Line + ','"/>
            </do_if>
            <run_actions ref="md.SWIBH_Log.Json_Engagement" result="$V2">
              <param name="In" value="$E1"/>
            </run_actions>
            <set_value name="$Line" exact="$Line + $V2"/>
          </do_for_each>
          <set_value name="$Line" exact="$Line + ']'"/>
        </do_else>
        <do_if value="$failedStep == null">
          <set_value name="$Line" exact="$Line + ',&quot;failedStep&quot;:null'"/>
        </do_if>
        <do_else>
          <set_value name="$Line" exact="$Line + ',&quot;failedStep&quot;:' + '&quot;%s&quot;'.[$failedStep]"/>
        </do_else>
        <do_if value="$payout == null">
          <set_value name="$Line" exact="$Line + ',&quot;payout&quot;:null'"/>
        </do_if>
        <do_else>
          <run_actions ref="md.SWIBH_Log.Json_Payout" result="$V1">
            <param name="In" value="$payout"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + ',&quot;payout&quot;:' + $V1"/>
        </do_else>
        <set_value name="$Line" exact="$Line + ',&quot;relations&quot;:['"/>
        <do_for_each name="$E1" in="$relations" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Line" exact="$Line + ','"/>
          </do_if>
          <run_actions ref="md.SWIBH_Log.Json_RelationChange" result="$V2">
            <param name="In" value="$E1"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + $V2"/>
        </do_for_each>
        <set_value name="$Line" exact="$Line + ']'"/>
        <set_value name="$Line" exact="$Line + ',&quot;repairs&quot;:['"/>
        <do_for_each name="$E1" in="$repairs" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Line" exact="$Line + ','"/>
          </do_if>
          <run_actions ref="md.SWIBH_Log.Json_Repair" result="$V2">
            <param name="In" value="$E1"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + $V2"/>
        </do_for_each>
        <set_value name="$Line" exact="$Line + ']'"/>
        <set_value name="$Line" exact="$Line + ',&quot;result&quot;:' + '&quot;%s&quot;'.[$result]"/>
        <do_if value="$targetKills == null">
          <set_value name="$Line" exact="$Line + ',&quot;targetKills&quot;:null'"/>
        </do_if>
        <do_else>
          <run_actions ref="md.SWIBH_Log.Json_ClassCounts" result="$V1">
            <param name="In" value="$targetKills"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + ',&quot;targetKills&quot;:' + $V1"/>
        </do_else>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
    <!-- Writes a player.loss log event. Params: lost, value, killer, piloted, activeHunts -->
    <library name="Log_PlayerLoss" purpose="run_actions">
      <params>
        <param name="lost"/>
        <param name="value"/>
        <param name="killer" default="null"/>
        <param name="piloted"/>
        <param name="activeHunts"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;player.loss&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;activeHunts&quot;:['"/>
        <do_for_each name="$E1" in="$activeHunts" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Line" exact="$Line + ','"/>
          </do_if>
          <run_actions ref="md.SWIBH_Log.Json_ActiveHunt" result="$V2">
            <param name="In" value="$E1"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + $V2"/>
        </do_for_each>
        <set_value name="$Line" exact="$Line + ']'"/>
        <do_if value="$killer == null">
          <set_value name="$Line" exact="$Line + ',&quot;killer&quot;:null'"/>
        </do_if>
        <do_else>
          <run_actions ref="md.SWIBH_Log.Json_Ref" result="$V1">
            <param name="In" value="$killer"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + ',&quot;killer&quot;:' + $V1"/>
        </do_else>
        <run_actions ref="md.SWIBH_Log.Json_Ship" result="$V1">
          <param name="In" value="$lost"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;lost&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + ',&quot;piloted&quot;:' + (if $piloted then 'true' else 'false')"/>
        <set_value name="$Line" exact="$Line + ',&quot;value&quot;:' + '%s'.[$value]"/>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
    <!-- Writes a engagement.start log event. Params: hunt, ship, wingmen, firstHit, attacker, attacked -->
    <library name="Log_EngagementStart" purpose="run_actions">
      <params>
        <param name="hunt" default="null"/>
        <param name="ship"/>
        <param name="wingmen"/>
        <param name="firstHit"/>
        <param name="attacker"/>
        <param name="attacked"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;engagement.start&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <do_if value="$hunt != null">
          <set_value name="$Line" exact="$Line + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$hunt]"/>
        </do_if>
        <run_actions ref="md.SWIBH_Log.Json_Ref" result="$V1">
          <param name="In" value="$attacked"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;attacked&quot;:' + $V1"/>
        <run_actions ref="md.SWIBH_Log.Json_Ref" result="$V1">
          <param name="In" value="$attacker"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;attacker&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + ',&quot;firstHit&quot;:' + '&quot;%s&quot;'.[$firstHit]"/>
        <run_actions ref="md.SWIBH_Log.Json_Ship" result="$V1">
          <param name="In" value="$ship"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;ship&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + ',&quot;wingmen&quot;:' + '%s'.[($wingmen)i]"/>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
    <!-- Writes a engagement.end log event. Params: hunt, start, lastHit, reason, ships, opponents, opponentsSeen -->
    <library name="Log_EngagementEnd" purpose="run_actions">
      <params>
        <param name="hunt" default="null"/>
        <param name="start"/>
        <param name="lastHit"/>
        <param name="reason"/>
        <param name="ships"/>
        <param name="opponents"/>
        <param name="opponentsSeen"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;engagement.end&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <do_if value="$hunt != null">
          <set_value name="$Line" exact="$Line + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$hunt]"/>
        </do_if>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;lastHit&quot;:' + '%s'.[($lastHit)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;opponents&quot;:['"/>
        <do_for_each name="$E1" in="$opponents" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Line" exact="$Line + ','"/>
          </do_if>
          <run_actions ref="md.SWIBH_Log.Json_Opponent" result="$V2">
            <param name="In" value="$E1"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + $V2"/>
        </do_for_each>
        <set_value name="$Line" exact="$Line + ']'"/>
        <set_value name="$Line" exact="$Line + ',&quot;opponentsSeen&quot;:' + '%s'.[($opponentsSeen)i]"/>
        <set_value name="$Line" exact="$Line + ',&quot;reason&quot;:' + '&quot;%s&quot;'.[$reason]"/>
        <set_value name="$Line" exact="$Line + ',&quot;ships&quot;:['"/>
        <do_for_each name="$E1" in="$ships" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Line" exact="$Line + ','"/>
          </do_if>
          <run_actions ref="md.SWIBH_Log.Json_WingShip" result="$V2">
            <param name="In" value="$E1"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + $V2"/>
        </do_for_each>
        <set_value name="$Line" exact="$Line + ']'"/>
        <set_value name="$Line" exact="$Line + ',&quot;start&quot;:' + '%s'.[($start)f]"/>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
  </cues>
</mdscript>
