      <actions>
        <set_value name="$Json" exact="''"/>
        <set_value name="$Json" exact="$Json + '{&quot;amount&quot;:' + '%s'.[($In.$amount)f]"/>
        <run_actions ref="md.SWIBH_Log.Json_FactionRef" result="$V1">
          <param name="In" value="$In.$faction"/>
        </run_actions>
        <set_value name="$Json" exact="$Json + ',&quot;faction&quot;:' + $V1"/>
        <set_value name="$Json" exact="$Json + ',&quot;reason&quot;:' + '&quot;%s&quot;'.[$In.$reason]"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
      </actions>
    </library>
    <!-- A Repair as JSON -->
    <library name="Json_Repair" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
        <set_value name="$Json" exact="''"/>
        <set_value name="$Json" exact="$Json + '{&quot;repairprice&quot;:' + '%s'.[$In.$repairprice]"/>
        <run_actions ref="md.SWIBH_Log.Json_Ship" result="$V1">
          <param name="In" value="$In.$ship"/>
        </run_actions>
        <set_value name="$Json" exact="$Json + ',&quot;ship&quot;:' + $V1"/>
        <set_value name="$Json" exact="$Json + '}'"/>
