        <set_value name="$Json" exact="$Json + ',&quot;idcode&quot;:' + '&quot;%s&quot;'.[$In.idcode]"/>
        <set_value name="$Json" exact="$Json + ',&quot;macro&quot;:' + '&quot;%s&quot;'.[$In.macro.id]"/>
        <run_actions ref="md.SWIBH_Log.Json_Name" result="$V1">
          <param name="In" value="$In.knownname"/>
        </run_actions>
        <set_value name="$Json" exact="$Json + ',&quot;name&quot;:' + $V1"/>
        <set_value name="$Json" exact="$Json + ',&quot;owner&quot;:' + '&quot;%s&quot;'.[$In.owner.id]"/>
        <set_value name="$Json" exact="$Json + '}'"/>
