    </library>
    <!-- A ActiveHunt as JSON -->
    <library name="Json_ActiveHunt" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
        <set_value name="$Json" exact="''"/>
        <set_value name="$Json" exact="$Json + '{&quot;byHuntWing&quot;:' + (if $In.$byHuntWing then 'true' else 'false')"/>
        <set_value name="$Json" exact="$Json + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$In.$hunt]"/>
        <set_value name="$Json" exact="$Json + ',&quot;sameSector&quot;:' + (if $In.$sameSector then 'true' else 'false')"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
      </actions>
    </library>
    <!-- A WingShip as JSON -->
    <library name="Json_WingShip" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
        <set_value name="$Json" exact="''"/>
        <set_value name="$Json" exact="$Json + '{&quot;class&quot;:' + '&quot;%s&quot;'.[$In.$class]"/>
        <set_value name="$Json" exact="$Json + ',&quot;destroyed&quot;:' + (if $In.$destroyed then 'true' else 'false')"/>
        <set_value name="$Json" exact="$Json + ',&quot;hitsDealt&quot;:' + '%s'.[($In.$hitsDealt)i]"/>
        <set_value name="$Json" exact="$Json + ',&quot;hitsTaken&quot;:' + '%s'.[($In.$hitsTaken)i]"/>
        <set_value name="$Json" exact="$Json + ',&quot;idcode&quot;:' + '&quot;%s&quot;'.[$In.$idcode]"/>
        <set_value name="$Json" exact="$Json + ',&quot;kills&quot;:' + '%s'.[($In.$kills)i]"/>
        <set_value name="$Json" exact="$Json + ',&quot;macro&quot;:' + '&quot;%s&quot;'.[$In.$macro]"/>
        <run_actions ref="md.SWIBH_Log.Json_Name" result="$V1">
          <param name="In" value="$In.$name"/>
        </run_actions>
        <set_value name="$Json" exact="$Json + ',&quot;name&quot;:' + $V1"/>
        <set_value name="$Json" exact="$Json + ',&quot;player&quot;:' + (if $In.$player then 'true' else 'false')"/>
        <set_value name="$Json" exact="$Json + ',&quot;sectors&quot;:['"/>
        <do_for_each name="$E1" in="$In.$sectors" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Json" exact="$Json + ','"/>
          </do_if>
          <set_value name="$Json" exact="$Json + '&quot;%s&quot;'.[$E1]"/>
        </do_for_each>
        <set_value name="$Json" exact="$Json + ']'"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
      </actions>
    </library>
    <!-- A Opponent as JSON -->
    <library name="Json_Opponent" purpose="run_actions">
      <params>
