<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/log/generate.ts from tools/log/schema.ts. Don't edit it: change the schema
     and run make log-xml. MD writes log events only through these libraries (ADR 0001), e.g.
       <run_actions ref="md.SWIBH_Log.Log_HuntKill">
         <param name="hunt" value="$HuntKey"/>
         <param name="victim" value="$Ship"/>
         ...
       </run_actions> -->
<mdscript name="SWIBH_Log" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Display text as a JSON string, after a lossy cleanup: " to ', \ to /, newline to space -->
    <library name="Json_Name" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
        <set_value name="$Text" exact="'%s'.[$In]"/>
        <substitute_text text="$Text">
          <replace string="'&quot;'" with="'\''"/>
        </substitute_text>
        <substitute_text text="$Text">
          <replace string="'\\'" with="'/'"/>
        </substitute_text>
        <substitute_text text="$Text">
          <replace string="'\n'" with="' '"/>
        </substitute_text>
        <return value="'&quot;' + $Text + '&quot;'"/>
      </actions>
    </library>
    <!-- A FactionRef as JSON -->
    <library name="Json_FactionRef" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
        <set_value name="$Json" exact="''"/>
        <set_value name="$Json" exact="$Json + '{&quot;id&quot;:' + '&quot;%s&quot;'.[$In.id]"/>
        <run_actions ref="md.SWIBH_Log.Json_Name" result="$V1">
          <param name="In" value="$In.knownname"/>
        </run_actions>
        <set_value name="$Json" exact="$Json + ',&quot;name&quot;:' + $V1"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
      </actions>
    </library>
    <!-- A Ref as JSON -->
    <library name="Json_Ref" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
        <set_value name="$Json" exact="''"/>
        <do_if value="@$In.idcode == null">
          <set_value name="$Json" exact="$Json + '{&quot;idcode&quot;:null'"/>
        </do_if>
        <do_else>
          <set_value name="$Json" exact="$Json + '{&quot;idcode&quot;:' + '&quot;%s&quot;'.[@$In.idcode]"/>
        </do_else>
        <set_value name="$Json" exact="$Json + ',&quot;macro&quot;:' + '&quot;%s&quot;'.[$In.macro.id]"/>
        <run_actions ref="md.SWIBH_Log.Json_Name" result="$V1">
          <param name="In" value="$In.knownname"/>
        </run_actions>
        <set_value name="$Json" exact="$Json + ',&quot;name&quot;:' + $V1"/>
        <set_value name="$Json" exact="$Json + ',&quot;owner&quot;:' + '&quot;%s&quot;'.[$In.owner.id]"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
      </actions>
    </library>
    <!-- A Ship as JSON -->
    <library name="Json_Ship" purpose="run_actions">
      <params>
        <param name="In"/>
      </params>
      <actions>
