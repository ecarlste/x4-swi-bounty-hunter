        <set_value name="$Json" exact="$Json + ',&quot;owner&quot;:' + '&quot;%s&quot;'.[$In.$owner]"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
      </actions>
    </library>
    <!-- Writes a session.start log event. Params: saveMarker, gameVersion, swiVersion -->
    <library name="Log_SessionStart" purpose="run_actions">
      <params>
        <param name="saveMarker"/>
        <param name="gameVersion"/>
        <param name="swiVersion" default="null"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;session.start&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;gameVersion&quot;:' + '&quot;%s&quot;'.[$gameVersion]"/>
        <set_value name="$Line" exact="$Line + ',&quot;saveMarker&quot;:' + '&quot;%s&quot;'.[$saveMarker]"/>
        <do_if value="$swiVersion == null">
          <set_value name="$Line" exact="$Line + ',&quot;swiVersion&quot;:null'"/>
        </do_if>
        <do_else>
          <set_value name="$Line" exact="$Line + ',&quot;swiVersion&quot;:' + '&quot;%s&quot;'.[$swiVersion]"/>
        </do_else>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
    <!-- Writes a hunt.accept log event. Params: hunt, missionId, faction, wharf, difficulty, target, sizeClass, offered, wing, sanction -->
    <library name="Log_HuntAccept" purpose="run_actions">
      <params>
        <param name="hunt"/>
        <param name="missionId"/>
        <param name="faction"/>
        <param name="wharf"/>
        <param name="difficulty"/>
        <param name="target"/>
        <param name="sizeClass"/>
        <param name="offered"/>
        <param name="wing"/>
        <param name="sanction"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;hunt.accept&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$hunt]"/>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;difficulty&quot;:' + '&quot;%s&quot;'.[$difficulty]"/>
        <run_actions ref="md.SWIBH_Log.Json_FactionRef" result="$V1">
          <param name="In" value="$faction"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;faction&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + ',&quot;missionId&quot;:' + '&quot;%s&quot;'.[$missionId]"/>
        <run_actions ref="md.SWIBH_Log.Json_Offer" result="$V1">
          <param name="In" value="$offered"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;offered&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + ',&quot;sanction&quot;:' + '&quot;%s&quot;'.[$sanction]"/>
        <set_value name="$Line" exact="$Line + ',&quot;sizeClass&quot;:' + '&quot;%s&quot;'.[$sizeClass]"/>
        <run_actions ref="md.SWIBH_Log.Json_Ship" result="$V1">
          <param name="In" value="$target"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;target&quot;:' + $V1"/>
        <run_actions ref="md.SWIBH_Log.Json_Ref" result="$V1">
          <param name="In" value="$wharf"/>
        </run_actions>
        <set_value name="$Line" exact="$Line + ',&quot;wharf&quot;:' + $V1"/>
        <set_value name="$Line" exact="$Line + ',&quot;wing&quot;:['"/>
        <do_for_each name="$E1" in="$wing" counter="$I1">
          <do_if value="$I1 gt 1">
            <set_value name="$Line" exact="$Line + ','"/>
          </do_if>
          <run_actions ref="md.SWIBH_Log.Json_Ship" result="$V2">
            <param name="In" value="$E1"/>
          </run_actions>
          <set_value name="$Line" exact="$Line + $V2"/>
        </do_for_each>
        <set_value name="$Line" exact="$Line + ']'"/>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
      </actions>
    </library>
    <!-- Writes a hunt.sanction log event. Params: hunt, tier, cost -->
    <library name="Log_HuntSanction" purpose="run_actions">
      <params>
        <param name="hunt"/>
        <param name="tier"/>
        <param name="cost"/>
      </params>
      <actions>
        <set_value name="$Line" exact="'{&quot;v&quot;:1,&quot;type&quot;:&quot;hunt.sanction&quot;,&quot;t&quot;:' + '%s'.[(player.age)f]"/>
        <set_value name="$Line" exact="$Line + ',&quot;hunt&quot;:' + '&quot;%s&quot;'.[$hunt]"/>
        <set_value name="$Line" exact="$Line + ',&quot;data&quot;:{&quot;cost&quot;:' + '%s'.[$cost]"/>
        <set_value name="$Line" exact="$Line + ',&quot;tier&quot;:' + '&quot;%s&quot;'.[$tier]"/>
        <set_value name="$Line" exact="$Line + '}}'"/>
        <debug_text text="'[swibh] ' + $Line" context="false" filter="general"/>
