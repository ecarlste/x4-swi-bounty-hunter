        <set_value name="$Json" exact="$Json + ',&quot;damage&quot;:' + '%s'.[($In.$damage)f]"/>
        <set_value name="$Json" exact="$Json + ',&quot;idcode&quot;:' + '&quot;%s&quot;'.[$In.$idcode]"/>
        <set_value name="$Json" exact="$Json + ',&quot;killed&quot;:' + (if $In.$killed then 'true' else 'false')"/>
        <set_value name="$Json" exact="$Json + ',&quot;owner&quot;:' + '&quot;%s&quot;'.[$In.$owner]"/>
        <set_value name="$Json" exact="$Json + '}'"/>
        <return value="$Json"/>
