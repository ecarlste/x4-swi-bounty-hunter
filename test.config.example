# X4 game test configuration (make game-test, make check)
# Copy this file to test.config (or run `make setup`) and set your paths.
#
# The same file works from WSL and PowerShell: a Windows path (E:\...) and a WSL /mnt/<drive>/
# path both work. Quotes are optional. Environment variables of the same names override this file.

# The X4 8.00 install that has SWI in extensions\starwarsmod_m1
X4_PATH="E:\SteamLibrary\steamapps\common\X4 Foundations - 8.00"
# Started directly with -skipintro -debug all -logfile debuglog.txt -scriptlogfiles -personalfolderid <X4_PROFILE_ID>
X4_EXE="X4_nonsteam.exe"
# The test profile: Documents\Egosoft\X4\<id>\. Must be numeric, or X4 falls back to the root
# profile (the real playthrough's). 90000001 and 90000002 were used by an earlier spike.
X4_PROFILE_ID="90000201"
# Optional: where the profile folders are (default <Documents>\Egosoft\X4, from Windows)
# X4_PROFILE_ROOT="C:\Users\you\OneDrive\Documents\Egosoft\X4"

# Offline checks only (make check): the unpacked vanilla 8.00 base game, the folder holding
# libraries\md.xsd (DLC folders next to it are read too), and SWI 0.90's unpacked reference
X4_UNPACKED="E:\x4-dev\reference\x4-8.00\base"
SWI_UNPACKED="E:\x4-dev\reference\mods\swi-0.90"
